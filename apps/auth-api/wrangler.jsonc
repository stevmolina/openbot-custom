{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openbot-auth-api",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker-entry.ts",
  "workers_dev": false,
  "preview_urls": false,
  "cache": {
    "enabled": true,
    "cross_version_cache": false
  },
  // Workers Logs stay off: they kept one event for each request, and their cost was larger than the cost of
  // the requests. `wrangler tail` still shows live events. `false` turns off a setting made earlier.
  "observability": {
    "enabled": false
  },
  // The Cloudflare Vite plugin emits and uploads Worker source maps unless this is false. The Worker
  // bundles the web app, and its maps pass the 60 MiB upload limit, so every deploy fails.
  "upload_source_maps": false,
  // The outbox, the hosted-site cleanup and the hosted server checks are retry paths: the request path
  // and the webhooks do the first attempt. A run each minute only repeated empty reads. An idle server
  // stops 15 to 20 minutes after its last use.
  "triggers": {
    // The second cron runs only the Signal entry check (`signal-entry-failover.ts`), each minute.
    "crons": ["*/5 * * * *", "*/1 * * * *"]
  },
  "routes": [
    {
      "pattern": "api.pokebots.xyz",
      "custom_domain": true
    },
    // The web app address. A route, not a custom domain: the DNS record stays proxied, and the
    // pokebots-app-host Worker (workers/app-host) owns the exact paths "/" and "/sw.js".
    // pokebots.xyz is the landing page on the OVH VPS.
    {
      "pattern": "app.pokebots.xyz/*",
      "zone_name": "pokebots.xyz"
    }
  ],
  "secrets": {
    "required": [
      "SKILLS_ADMIN_TOKEN",
      "SITE_REPORT_HASH_SECRET",
      "REMOTE_TICKET_PRIVATE_JWK",
      "REMOTE_TICKET_PUBLIC_JWKS",
      "REMOTE_AUTH_WEBHOOK_SECRET"
    ]
  },
  "vars": {
    "AUTH_EXPOSE_DEVELOPMENT_CODE": "false",
    "EMAIL_SMTP_HOST": "",
    "EMAIL_SMTP_PORT": "",
    "EMAIL_SMTP_USERNAME": "",
    "EMAIL_FROM": "",
    "EMAIL_LICENSE_FROM": "",
    "REMOTE_TICKET_KEY_ID": "self-hosted-1",
    "REMOTE_SIGNAL_URL": "wss://signal.pokebots.xyz/v1/signal",
    // One Signal machine. An empty REMOTE_SIGNAL_HOMES keeps every ticket on REMOTE_SIGNAL_URL.
    "REMOTE_SIGNAL_HOMES": "",
    "REMOTE_SIGNAL_HOME_LOCATIONS": "",
    "REMOTE_AUTH_WEBHOOK_URL": "https://signal.pokebots.xyz/internal/auth-events",
    "REMOTE_AUTH_WEBHOOK_URLS": "",
    // No second Signal machine, so the entry check stays off.
    "SIGNAL_ENTRY_ZONE_ID": "",
    "HOSTED_SERVERS_ENABLED": "false",
    // Each account can buy a server in production. Put account IDs here to limit creates to them.
    "HOSTED_SERVERS_ALLOWED_USER_IDS": "*",
    // A license bought before this time is free until then: Stripe charges its first payment at this time.
    // Local development reads it too; set LICENSE_TRIAL_END= in the shell to sell licenses with no trial.
    "LICENSE_TRIAL_END": "2026-12-01T00:00:00Z",
    // The public Client ID of the OpenBotGit GitHub App. Its private key is the optional secret
    // GITHUB_APP_PRIVATE_KEY (PKCS #8). Without the key, agents act on GitHub as the signed-in user.
    "GITHUB_APP_CLIENT_ID": "Iv23lik5pzHz70cb0RUL",
    "APNS_TEAM_ID": "8A47NKRZSJ",
    "APNS_TOPIC": "run.openbot.mobile"
  },
  // Email leaves through the relay Worker (`wrangler.email-relay.jsonc`), which runs near the mail
  // host. Only production has it: the preview and test Workers and `vite dev` send from their own
  // socket. Deploy the relay before this Worker.
  "services": [
    {
      "binding": "EMAIL_RELAY",
      "service": "openbot-email-relay"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pokebots-auth",
      "database_id": "40f2c207-9987-4661-80ee-9966b8759706",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "pokebots-avatars",
      "preview_bucket_name": "pokebots-avatars-test"
    },
    {
      "binding": "SKILLS",
      "bucket_name": "pokebots-skills",
      "preview_bucket_name": "pokebots-skills-test"
    },
    {
      "binding": "SITES",
      "bucket_name": "pokebots-sites",
      "preview_bucket_name": "pokebots-sites-test"
    }
  ],
  "ratelimits": [
    {
      "name": "MARKETPLACE_INGRESS_RATE_LIMITER",
      "namespace_id": "2026082701",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "MARKETPLACE_MUTATION_RATE_LIMITER",
      "namespace_id": "2026082702",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "MARKETPLACE_UPLOAD_RATE_LIMITER",
      "namespace_id": "2026082703",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "SITE_REPORT_RATE_LIMITER",
      "namespace_id": "2026083101",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "GITHUB_TOKEN_RATE_LIMITER",
      "namespace_id": "2026092911",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "LIVE_ACTIVITY_RATE_LIMITER",
      "namespace_id": "2026092901",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "2026110801",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "env": {
    "preview": {
      "name": "openbot-landing-preview",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "triggers": {
        "crons": []
      },
      "secrets": {
        "required": []
      },
      "vars": {
        "AUTH_EXPOSE_DEVELOPMENT_CODE": "false",
        "EMAIL_SMTP_HOST": "mail.privateemail.com",
        "EMAIL_SMTP_PORT": "465",
        "EMAIL_SMTP_USERNAME": "hello@openbot.run",
        "EMAIL_FROM": "hello@openbot.run",
        "EMAIL_LICENSE_FROM": "licenses@openbot.run",
        "SITE_PUBLISH_ENABLED": "false",
        "SITE_COOKIE_ISOLATION_READY": "false",
        "REMOTE_TICKET_KEY_ID": "openbot-remote-1",
        "REMOTE_SIGNAL_URL": "ws://127.0.0.1:8081/v1/signal",
        "REMOTE_SIGNAL_HOMES": "",
        "REMOTE_AUTH_WEBHOOK_URL": "http://127.0.0.1:8081/internal/auth-events",
        "REMOTE_AUTH_WEBHOOK_URLS": "",
        "SIGNAL_ENTRY_ZONE_ID": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "openbot-auth-test",
          "database_id": "38f1a836-6c70-44bb-bbf3-f0bbc5b766b3",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "AVATARS",
          "bucket_name": "openbot-avatars-test"
        },
        {
          "binding": "SKILLS",
          "bucket_name": "openbot-skills-test"
        },
        {
          "binding": "SITES",
          "bucket_name": "openbot-sites-test"
        }
      ],
      "ratelimits": [
        {
          "name": "MARKETPLACE_INGRESS_RATE_LIMITER",
          "namespace_id": "2026082704",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "MARKETPLACE_MUTATION_RATE_LIMITER",
          "namespace_id": "2026082705",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "MARKETPLACE_UPLOAD_RATE_LIMITER",
          "namespace_id": "2026082706",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "SITE_REPORT_RATE_LIMITER",
          "namespace_id": "2026083102",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "GITHUB_TOKEN_RATE_LIMITER",
          "namespace_id": "2026092912",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "LIVE_ACTIVITY_RATE_LIMITER",
          "namespace_id": "2026092902",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "FEEDBACK_RATE_LIMITER",
          "namespace_id": "2026110802",
          "simple": { "limit": 3, "period": 60 }
        }
      ]
    },
    "test": {
      "name": "openbot-auth-api-test",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      // Each minute: the cron starts hosted servers that stopped again, and checks servers that a webhook missed.
      "triggers": {
        "crons": ["* * * * *"]
      },
      // Hosted servers stay off until these are set. `api:deploy:test` sets the Stripe pair, BOAT_API_KEY,
      // BOAT_WEBHOOK_SECRET and HOSTED_SERVERS_DEVELOPER_KEY from the `.env.dev`, and
      // HOSTED_SERVERS_ALLOWED_USER_IDS from its HOSTED_SERVERS_TEST_ALLOW_LIST.
      // Set HOSTED_SERVER_TEMPLATE with `wrangler secret put <name> --env test`.
      // They are not required, so the test Worker deploys without them. See docs/hosted-servers.md.
      "secrets": {
        "required": [
          "EMAIL_SMTP_PASSWORD",
          "SKILLS_ADMIN_TOKEN",
          "SITE_REPORT_HASH_SECRET",
          "REMOTE_TICKET_PRIVATE_JWK",
          "REMOTE_TICKET_PUBLIC_JWKS",
          "REMOTE_AUTH_WEBHOOK_SECRET"
        ]
      },
      "vars": {
        "AUTH_EXPOSE_DEVELOPMENT_CODE": "false",
        "EMAIL_SMTP_HOST": "mail.privateemail.com",
        "EMAIL_SMTP_PORT": "465",
        "EMAIL_SMTP_USERNAME": "hello@openbot.run",
        "EMAIL_FROM": "hello@openbot.run",
        "EMAIL_LICENSE_FROM": "licenses@openbot.run",
        "SITE_PUBLISH_ENABLED": "false",
        "SITE_COOKIE_ISOLATION_READY": "false",
        "REMOTE_TICKET_KEY_ID": "openbot-remote-1",
        "REMOTE_SIGNAL_URL": "wss://signal.openbot.run/v1/signal",
        "REMOTE_SIGNAL_HOMES": "",
        "REMOTE_AUTH_WEBHOOK_URL": "https://signal.openbot.run/internal/auth-events",
        "REMOTE_AUTH_WEBHOOK_URLS": "",
        // The test Worker never moves the production entry name.
        "SIGNAL_ENTRY_ZONE_ID": "",
        "HOSTED_SERVERS_ENABLED": "true",
        "GITHUB_APP_CLIENT_ID": "Iv23lik5pzHz70cb0RUL",
        "APNS_TEAM_ID": "8A47NKRZSJ",
        "APNS_TOPIC": "run.openbot.mobile"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "openbot-auth-test",
          "database_id": "38f1a836-6c70-44bb-bbf3-f0bbc5b766b3",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "AVATARS",
          "bucket_name": "openbot-avatars-test"
        },
        {
          "binding": "SKILLS",
          "bucket_name": "openbot-skills-test"
        },
        {
          "binding": "SITES",
          "bucket_name": "openbot-sites-test"
        }
      ],
      "ratelimits": [
        {
          "name": "MARKETPLACE_INGRESS_RATE_LIMITER",
          "namespace_id": "2026082707",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "MARKETPLACE_MUTATION_RATE_LIMITER",
          "namespace_id": "2026082708",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "MARKETPLACE_UPLOAD_RATE_LIMITER",
          "namespace_id": "2026082709",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "SITE_REPORT_RATE_LIMITER",
          "namespace_id": "2026083103",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "GITHUB_TOKEN_RATE_LIMITER",
          "namespace_id": "2026092913",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "LIVE_ACTIVITY_RATE_LIMITER",
          "namespace_id": "2026092903",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "FEEDBACK_RATE_LIMITER",
          "namespace_id": "2026110803",
          "simple": { "limit": 3, "period": 60 }
        }
      ]
    }
  }
}
