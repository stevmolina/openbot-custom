# Workers static assets read this file. Vite puts a content hash in every name
# under /assets/, so a changed file always has a new URL and a browser can keep
# the old one for a year without asking again.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker of the web client. A browser checks this file for a new version, so no cache
# may keep it: the file changes with each build, and an old copy would hold back an update.
/app-sw.js
  Cache-Control: no-cache
